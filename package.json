{
  "name": "t3-you-should-know",
  "version": "0.1.0",
  "description": "Shows a short 'You should know' note in T3 Code chats, on stock T3 (Claude Code and Codex).",
  "type": "module",
  "bin": {
    "t3-ysk": "./bin/t3-ysk.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vitest": "latest"
  }
}
